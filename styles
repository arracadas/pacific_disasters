/* Base styles */
:root {
  --primary-color: #0077BE;
  --secondary-color: #4ECDC4;
  --accent-color: #FF6B6B;
  --text-color: #333333;
  --light-text: #666666;
  --background-color: #fafafa;
  --header-bg: #ffffff;
  --border-color: #e0e0e0;
}

/* Global body styles */
body {
  font-family: 'Jost', 'Montserrat', sans-serif;
  line-height: 1.7;
  color: var(--text-color);
  background-color: #FF00FF !important;
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem;
}

/* Full-width container for charts */
.full-width {
  width: 100vw !important;
  max-width: 100vw !important;
  margin-left: 50% !important;
  transform: translateX(-50%) !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}

/* Ensure Quarto figures respect full-width */
.full-width figure {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
}

/* Prevent horizontal overflow for other elements */
.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  overflow-x: hidden;
}